// Warehouse HQ backend — Prisma schema.
//
// Replaces the in-memory arrays each service used to hold (see git
// history / docs/architecture.md for the "TEMPORARY IN-MEMORY STORE"
// era). Deliberately a near-literal mirror of the domain types in
// src/**/*.types.ts — services map DB rows to those same domain shapes,
// so DTOs/controllers/guards were untouched by this migration.
//
// No cross-table foreign keys (e.g. PutAwayTask.assignedToUserId -> User.id)
// on purpose: the app already validates these references at the service
// layer (usersService.findById checks) before writing, exactly like the
// in-memory version did. Adding DB-level FK constraints would make
// removing a user who has any history (a completed shift, a past task)
// fail with a constraint violation — a behavior change nobody asked for.
// If real referential integrity + cascade/restrict policy is wanted later,
// that's a deliberate product decision (soft-delete? keep history?), not
// a side effect of "add a database."

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  staff
  admin
  management
}

/**
 * Every admin-managed dropdown category lives in this one enum — adding
 * a new category (a new dropdown somewhere) is a one-line addition here
 * plus a migration, not a new table/service/controller. The generic
 * part the web app gets is managing *values* within any category
 * through one UI/API — see src/reference-lists/.
 */
enum ReferenceListCategory {
  transporter_company
  packaging_type
  /** Target locations for Putaway (e.g. "Zone A - Rack 04"). */
  warehouse_zone
  /** Admin-editable list of Report Issue types shown to staff. */
  issue_type
  /** Color tags used by Admin's multi-criteria batch assignment (e.g. Red/Blue). */
  color_tag
}

/** One admin-managed value within a category — see ReferenceListCategory's doc comment. */
model ReferenceListValue {
  id        String                 @id @default(uuid())
  category  ReferenceListCategory
  value     String
  createdAt DateTime               @default(now())

  @@unique([category, value])
  @@index([category])
}

enum ReceptionCategory {
  return_parcels
  packaging_stock
  sellers_stock
  equipment_other
}

enum ReceptionStatus {
  arrived
  ready_for_putaway
  completed
}

enum PalletCondition {
  good
  damaged
}

enum SellerStockStatus {
  ready_for_putaway
  pending_admin_review
  instructed
  put_away
}

enum PutAwayTaskStatus {
  assigned
  in_progress
  completed
  issue_reported
}

enum OrderPrepTaskRole {
  picker
  packer
}

enum OrderPrepTaskStatus {
  assigned
  in_progress
  completed
}

/** Set by Admin at assignment time (Task Board) — manual for now, per the user's own note that this will later be AI-assigned based on a ruleset. */
enum TaskPriority {
  normal
  high
  urgent
}

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role

  /**
   * Trial-gating fields — deliberately unused (loginLimit: null,
   * canCreateUsers: true) for every normal account, including every
   * seed/dev account. Only set on specific accounts handed to an
   * evaluating company for a time/usage-limited pilot before they've
   * committed to paying. Checked in AuthService.login() and
   * UsersService.create() respectively.
   */
  loginLimit     Int?
  loginCount     Int     @default(0)
  canCreateUsers Boolean @default(true)
}

model Shift {
  id        String    @id @default(uuid())
  userId    String
  startedAt DateTime
  endedAt   DateTime?

  /**
   * Updated by POST /shifts/heartbeat every ~15 min while the app is
   * open and this shift is active. If a shift goes stale (no heartbeat
   * within the tolerance window — see shifts.service.ts) it means the
   * app was very likely closed without the staff member pressing "End
   * Shift" — the next time anything checks this shift's status, it gets
   * auto-ended as of this timestamp. There's no background job doing
   * this proactively (none exists in this app), so it's a lazy/on-read
   * check — in practice it's discovered promptly anyway, since the
   * staff member's own next status poll or Admin's auto-refreshing
   * dashboard both trigger it.
   */
  lastHeartbeatAt DateTime?

  /**
   * One-shot flags set by ScheduleAlertsService's periodic check (see
   * schedules.module.ts) so a pre-warning / completion alert fires at
   * most once per shift, not on every tick of the scheduler.
   */
  paidBreakWarnedAt  DateTime?
  lunchBreakWarnedAt DateTime?
  hoursCompleteAt    DateTime?

  @@index([userId])
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

/**
 * Admin-configured per staff member (Admin Conf doc) — working days,
 * shift hours, required daily hours, and scheduled break start times.
 * Purely a target/reminder layer: it does NOT change how breaks are
 * actually started/ended (still staff-initiated, see Break model) or
 * enforce anything by itself — ScheduleAlertsService just uses it to
 * fire a pre-warning before each scheduled break and a completion
 * notice once required hours are reached, both over the RealtimeService
 * socket layer. One row per staff member; absence of a row just means
 * "no schedule configured yet" (no reminders fire, nothing else
 * changes) rather than an error — matches how every other optional
 * admin-configured feature in this app degrades.
 */
model StaffSchedule {
  userId String @id

  workingDays Weekday[]

  /** "HH:MM", 24h, no timezone — see ScheduleAlertsService's doc comment for why this is treated as UTC, same simplification as ReportsService's "today". */
  shiftStartTime String
  shiftEndTime   String

  requiredWorkingHours Float

  /** Reminder anchor only — the paid break itself is still staff-started/stopped and stays capped at SHORT_BREAK_LIMIT_MS regardless of this time. */
  paidBreakStartTime String?

  lunchBreakStartTime       String?
  lunchBreakDurationMinutes Int     @default(60)

  updatedAt DateTime @updatedAt
}

enum BreakType {
  /** Unpaid — subtracted from worked-hours totals. */
  lunch
  /** Paid — NOT subtracted; cumulative time is capped per shift (see SHORT_BREAK_LIMIT_MS in shifts.service.ts). */
  short
}

/**
 * A break within a shift — separate from Shift itself so staff can step
 * away without stopping/restarting their whole shift (the practical gap
 * the doc's own "Automated Break Management" future-dev section
 * anticipated, scoped down here to just staff-initiated start/end, no
 * admin-scheduled windows or reminders yet). One active (endedAt: null)
 * break per shift at a time, regardless of type — same pattern as one
 * active shift per user. `type` distinguishes the unpaid Lunch Break
 * from the paid, 20-minutes-per-shift Short Break; only `lunch` time is
 * subtracted from worked-hours totals (ReportsService, the Sheets
 * export) — `short` is paid, so it isn't.
 */
model Break {
  id        String    @id @default(uuid())
  shiftId   String
  type      BreakType @default(lunch)
  startedAt DateTime
  endedAt   DateTime?

  @@index([shiftId])
}

/**
 * ReceptionDetails (reception.types.ts) is a discriminated union in the
 * domain model; here it's flattened into nullable per-category columns
 * (only the columns matching `category` are ever populated) — the
 * service layer reconstructs the union on read. Simpler than a JSON
 * column for this small, fixed set of variants, and keeps columns
 * queryable/typed.
 */
model Reception {
  id                   String            @id @default(uuid())
  createdByUserId      String
  status               ReceptionStatus
  category             ReceptionCategory
  parcelCount          Int?
  transporterCompany   String?
  packagingType        String?
  palletCount          Int?
  itemDescription      String?
  arrivedAt            DateTime
  instructions         String?
  putAwayAt            DateTime?
  processingDurationMs Int?
  flaggedForReview     Boolean           @default(false)
}

/**
 * Multi-select staff self-report of what they observed on intake
 * (Staff View doc: "Multiple selections possible"). `condition`
 * (single good/damaged) stays as a derived legacy column — computed
 * from this and never removed, since it's still what needsReview/status
 * branching reads — see SellerStockService.create().
 */
enum PalletConditionFlag {
  good
  overweight
  overloaded
  damaged
  location_name_needed
}

model SellerStockPallet {
  id     String @id @default(uuid())
  /** Backs the human-readable "PLT-000001" index (was a service-level counter; now a real DB sequence). */
  seq    Int    @unique @default(autoincrement())

  boxNumber               String
  sellerName              String
  weightKg                Float
  overweightFlag          Boolean
  condition               PalletCondition
  /** New multi-select capture — see this model's own doc comment. Empty for pallets logged before this field existed. */
  conditionFlags          PalletConditionFlag[] @default([])
  damageRemarks           String?
  damageEvidencePhotoUrls String[]
  labelPhotoUrls          String[]
  status                  SellerStockStatus
  putAwayLocation         String?
  createdByUserId         String
  createdAt               DateTime          @default(now())
  putAwayAt               DateTime?
}

model PutAwayTask {
  id               String            @id @default(uuid())
  palletId         String
  assignedToUserId String
  assignedByUserId String
  location         String
  status           PutAwayTaskStatus
  assignedAt       DateTime
  startedAt        DateTime?
  completedAt      DateTime?
  durationMs       Int?
  issueDescription String?
  priority         TaskPriority      @default(normal)
  instructions     String?

  @@index([palletId])
  @@index([assignedToUserId])
}

model OrderPrepSession {
  id                  String    @id @default(uuid())
  totalParts          Int
  pickersNeeded       Int
  packersNeeded       Int
  packingDelayMinutes Int
  pickingStartedAt    DateTime?
  createdByUserId     String
  createdAt           DateTime  @default(now())
}

model OrderPrepTask {
  id               String              @id @default(uuid())
  sessionId        String
  role             OrderPrepTaskRole
  assignedToUserId String
  status           OrderPrepTaskStatus
  assignedAt       DateTime
  startedAt        DateTime?
  completedAt      DateTime?
  durationMs       Int?
  priority         TaskPriority        @default(normal)
  instructions     String?

  @@index([sessionId])
  @@index([assignedToUserId])
}
