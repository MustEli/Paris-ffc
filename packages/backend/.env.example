# Copy to .env (dev) and .env.test (e2e tests) — both are gitignored.
# Local Postgres, installed via `winget install PostgreSQL.PostgreSQL.17`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/warehouse_hq"
JWT_SECRET="dev-only-insecure-secret"

# Optional — only needed for the real hosted deploy (Render), not local
# dev. Leave unset locally: uploads fall back to local disk automatically
# when these three aren't all present (see src/uploads/uploads.storage.ts).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional Google Sheets export (see src/sheets). The spreadsheet ID is
# not a secret (it's just an address, not a credential) — copy it from
# the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS-PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=""
# Local dev: skip these two — instead save the service account key file
# to packages/backend/google-service-account.json (gitignored). These
# env vars are the fallback used when that file doesn't exist, i.e. the
# real hosted deploy (Render), where the key file is never present since
# it's gitignored and never gets deployed. Copy client_email/private_key
# straight out of the same downloaded JSON file.
GOOGLE_SHEETS_CLIENT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""
